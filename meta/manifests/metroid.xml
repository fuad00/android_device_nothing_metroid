<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for Nothing Phone (3) (metroid, SM8735 / tuna) on LineageOS lineage-23.2.
  Tree: /root/nothing_phone_3/lineage on the build server, separate from the OnePlus tree (git
  objects borrowed via repo init reference=...oneplus.../.repo/project-objects).
  Install: cp metroid.xml <top>/.repo/local_manifests/ && repo sync -c

  The kernel is not part of this tree: meta/kernel/ (own Kleaf manifest) builds it from source and
  stage-kernel.sh drops the result into device/nothing/metroid/kernel/out/.
  vendor/nothing/metroid is not a repository: it is generated from a stock Nothing OS
  B4.1-260814-1733 dump with device/nothing/metroid/extract-files.py --allow-prohibited-files
  (4.7 GB of Nothing/Qualcomm binaries that are not ours to publish).

  Platform forks carry logix727's lineage-23.0 carry series (android_device_nothing_metroid
  patches/), rebased onto lineage-23.2 as commits with their original authorship; each fork's
  branch is the upstream branch named here plus those commits.
-->
<manifest>
  <remote name="fuad00-metroid" fetch="https://github.com/fuad00" />

  <!-- Device (this monorepo: the tree is the repository root, docs and scripts are in meta/) -->
  <project path="device/nothing/metroid" name="android_device_nothing_metroid" remote="fuad00-metroid" revision="main" />

  <!-- Platform forks -->
  <remove-project name="LineageOS/android_build" path="build/make" />
  <project path="build/make" name="android_build" remote="fuad00-metroid" revision="lineage-23.2" groups="pdk,sysui-studio">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
